# Cargo build output. target/stage3/ is where this demo's JSON artifacts land.
/target/

# The chaincode repository, cloned in here before the first run and versioned
# separately. It has to sit at this exact path: fablo-config.json deploys the chaincode
# from ./fabric-vdr-core, resolved against the directory holding fablo-config.json.
/fabric-vdr-core/

# Network state generated by Fablo at bring-up. ./bootstrap.sh rebuilds both from
# fablo-config.json, so nothing here is worth keeping.
/fablo-target/
/chaincode-packages/

# Written into the project root by `fablo init` only (machine-specific UID/GID mappings).
# The demo never runs `init`, but Fablo's own copy step is indiscriminate.
/passwd
/group

# macOS
.DS_Store

# IDE / tooling
/.vscode/
/.idea/
/.claude/
